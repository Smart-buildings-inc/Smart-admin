# ATLAS OS environment.
#
# Local-first by design: the app renders on seed data with NO database connected.
# Set DATABASE_URL to a Neon (serverless Postgres) connection string to persist
# floors, incidents, and broadcasts. Leave it unset for the prototype experience.
#
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# Canonical site origin for sitemap.xml / robots.txt / canonical URLs.
# Optional: by default these resolve from the live request host, so connecting a
# real domain "just works" with no config. Set this only to pin a canonical
# origin (e.g. force the apex domain + https) regardless of the request host.
#
# NEXT_PUBLIC_SITE_URL="https://atlas.yourdomain.com"
#
# RuView WiFi-CSI presence sensing (https://github.com/ruvnet/RuView). When set,
# /api/presence reads live presence; unset → seed-derived (local-first).
# RUVIEW_API_URL="http://ruview.local:3000/api"
