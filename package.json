{
  "name": "atlas-os",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS OS — the Habitat Twin. Building operations platform for self-sufficient ATLAS habitats.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-next-output.mjs && npm run docs:build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run validate:gltf && npm run validate:models && npm run validate:blender && npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/lib/db/seed.ts",
    "validate:gltf": "node scripts/validate-gltf-assets.mjs",
    "validate:models": "npx tsx scripts/validate-model-slots.ts",
    "validate:blender": "python3 _blender/validate_naming_alignment.py",
    "docs:build": "node --import tsx scripts/generate-doc-pdfs.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "drizzle-orm": "^0.45.2",
    "marked": "^12.0.2",
    "next": "^15.5.19",
    "pdfkit": "^0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.16.11",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
